{
  "version": 2,
  "routes": [
    {
      "src": "/mp-api/(.*)",
      "dest": "https://api.materialsproject.org/$1"
    },
    {
      "src": "/mp-contribs-api/(.*)",
      "dest": "https://contribs-api.materialsproject.org/$1"
    },
    {
      "src": "/matscholar-api/(.*)",
      "dest": "https://www.matscholar.com/$1"
    },
    {
      "handle": "filesystem"
    }
  ]
}

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "git": {
    "deploymentEnabled": false
  },
  "rewrites": [
    {
      "source": "/mp-api/:path*",
      "destination": "https://api.materialsproject.org/:path*"
    },
    {
      "source": "/mp-contribs-api/:path*",
      "destination": "https://contribs-api.materialsproject.org/:path*"
    },
    {
      "source": "/matscholar-api/:path*",
      "destination": "https://www.matscholar.com/:path*"
    }
  ]
}

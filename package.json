{
  "name": "@hyacinth/mp-react18-components",
  "version": "0.1.0",
  "description": "Next generation Materials Project React components based on React 18 and Radix UI",
  "author": "hyacinth",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "rollup -c",
    "build:tsup": "tsup src/index.ts --dts --format esm,cjs",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "oxlint src",
    "format": "oxlint --fix src",
    "typecheck": "tsc --noEmit",
    "storybook": "HOME=$PWD/.storybook-home storybook dev -p 6006 --disable-telemetry",
    "build-storybook": "HOME=$PWD/.storybook-home storybook build --disable-telemetry"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0",
    "npm": ">=10.0.0"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^18.3.0",
    "react-dom": "^18.2.0 || ^18.3.0"
  },
  "dependencies": {
    "@microlink/react-json-view": "^1.31.18",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-table": "^8.21.3",
    "@types/d3-color": "^3.1.3",
    "axios": "^1.15.0",
    "bulma": "^0.9.4",
    "clsx": "^2.1.1",
    "d3-color": "^3.1.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.45",
    "react-graph-vis": "^1.0.5",
    "react-icons": "^4.12.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-highlight.js": "^7.0.1",
    "remark-math": "^6.0.0",
    "rxjs": "^7.8.2",
    "svgtodatauri": "^0.0.0",
    "three": "^0.163.0",
    "use-resize-observer": "^9.1.0",
    "uuid": "^13.0.0"

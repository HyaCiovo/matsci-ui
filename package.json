{
  "name": "@hyacinth/matsci-ui",
  "version": "0.1.0",
  "description": "MatsciUI: React component library for materials science research, based on Bulma and Radix UI",
  "author": "hyacinth",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "^20.19.0 || ^22.12.0",
    "npm": ">=10.0.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./crystal-toolkit": {
      "import": "./dist/crystal-toolkit.js",
      "types": "./dist/crystal-toolkit.d.ts"
    },
    "./markdown": {
      "import": "./dist/markdown.js",
      "types": "./dist/markdown.d.ts"
    },
    "./periodic-table": {
      "import": "./dist/periodic-table.js",
      "types": "./dist/periodic-table.d.ts"
    },
    "./publications": {
      "import": "./dist/publications.js",
      "types": "./dist/publications.d.ts"
    },
    "./search-ui": {
      "import": "./dist/search-ui.js",
      "types": "./dist/search-ui.d.ts"
    },
    "./style.css": "./dist/themes/bulma.css",
    "./themes/bulma.css": "./dist/themes/bulma.css",
    "./themes/gnosys.css": "./dist/themes/gnosys.css",
    "./themes/markdown.css": "./dist/themes/markdown.css",
    "./themes/default.css": "./dist/themes/bulma.css",
    "./themes/tech.css": "./dist/themes/gnosys.css",
    "./periodic-table.css": "./dist/themes/periodic-table.css"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/components.json",
    "!dist/themes/fonts/*.ttf"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.less"
  ],
  "scripts": {
    "build": "pnpm clean && pnpm build:lib:release && pnpm build:assets && pnpm build:meta",
    "build:assets": "node scripts/prepare-vis-network-assets.mjs",
    "build:lib": "rollup -c",
    "build:lib:release": "node scripts/build-lib-release.mjs",
    "build:meta": "node scripts/generate-components-json.mjs --dist-only",
    "build:npm:gnosys": "node scripts/publish-npm-gnosys.mjs --pack --dry-run",
    "build-storybook": "HOME=$PWD/.storybook-home storybook build --disable-telemetry && node scripts/prepare-storybook-vercel.mjs",
    "clean": "node scripts/clean-dist.mjs",
    "dev": "vite",
    "format": "oxlint --fix src",
    "generate:components": "node scripts/generate-components-json.mjs --root-only",
    "lint": "oxlint src",
    "pack:npm:gnosys": "node scripts/publish-npm-gnosys.mjs --pack",
    "pack:npm:gnosys:dry-run": "node scripts/publish-npm-gnosys.mjs --pack --dry-run",
    "prepare": "node scripts/run-prepare.mjs",
    "publish:npm:gnosys": "node scripts/publish-npm-gnosys.mjs",
    "publish:npm:gnosys:dry-run": "node scripts/publish-npm-gnosys.mjs --dry-run",
    "storybook": "HOME=$PWD/.storybook-home storybook dev -p 6006 --disable-telemetry --no-open",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=16.8.0 <19 || ^19.0.0",
    "react-dom": ">=16.8.0 <19 || ^19.0.0",
    "three": "^0.163.0"
  },
  "dependencies": {
    "@microlink/react-json-view": "^1.31.18",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-table": "^8.21.3",
    "bulma": "^0.9.4",
    "clsx": "^2.1.1",
    "d3-color": "^3.1.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.45",
    "react-graph-vis": "^1.0.5",
    "react-icons": "^4.12.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-highlight.js": "^7.0.1",
    "remark-math": "^6.0.0",
    "svgtodatauri": "^0.0.0",
    "use-resize-observer": "^9.1.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.8",
    "@rollup/plugin-node-resolve": "^15.3.1",
    "@rollup/plugin-swc": "^0.3.1",
    "@storybook/addon-docs": "^10.3.5",
    "@storybook/addon-links": "^10.3.5",
    "@storybook/addon-vitest": "^10.3.5",
    "@storybook/react": "^10.3.5",
    "@storybook/react-vite": "^10.3.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^15.0.7",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-color": "^3.1.3",
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.163.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^24.1.3",
    "lefthook": "^1.13.6",
    "less": "^4.6.4",
    "oxlint": "^0.2.18",
    "react": "^18.3.1",
    "react-docgen-typescript": "^2.2.2",
    "react-dom": "^18.3.1",
    "three": "^0.163.0",
    "rollup": "^4.60.1",
    "rollup-plugin-dts": "^6.4.0",
    "rollup-plugin-postcss": "^4.0.2",
    "shiki": "^4.0.2",
    "storybook": "^10.3.5",
    "typescript": "^5.9.3",
    "vite": "^6.4.2",
    "vitest": "^4.1.4"
  }
}
